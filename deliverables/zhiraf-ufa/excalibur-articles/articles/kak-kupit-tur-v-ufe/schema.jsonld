    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как купить тур в Уфе через агентство?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Оставьте заявку на сайте или позвоните в офис, получите бесплатную консультацию и 2–3 варианта с вылетом из Уфы, проверьте договор и оплатите удобным способом."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли приехать в офис «Жираф» без заявки на сайте?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Офис на ул. Гагарина, 74/1: Пн–Пт 10:00–19:00, Сб 11:00–15:00. Можно позвонить заранее, чтобы менеджер подготовил варианты."
          }
        },
        {
          "@type": "Question",
          "name": "Обязательно ли покупать тур после консультации?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Консультация бесплатная и не обязывает к оплате."
          }
        },
        {
          "@type": "Question",
          "name": "Что проверить в договоре перед оплатой тура?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ФИО и паспортные данные, рейсы из Уфы и обратно, отель и питание, сумма и график платежей, условия отмены и туроператор."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько длится подбор тура с вылетом из Уфы?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зависит от направления, сезона и дат. В пик сезона расчёт может занять больше времени — уточните срок ответа у менеджера."
          }
        },
        {
          "@type": "Question",
          "name": "Отличается ли покупка тура с детьми?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да: возраст детей влияет на цену, рассадку и документы. Сообщите состав семьи при первой заявке."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если планы меняются после бронирования?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сразу свяжитесь с агентством: условия переноса или отмены зависят от договора и правил туроператора на момент брони."
          }
        }
      ]
    }
