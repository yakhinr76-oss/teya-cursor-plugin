      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Обязательна ли медицинская страховка в тур?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для выезда за рубеж полис практически всегда нужен; иногда он уже в пакете. Проверьте договор."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли оформить страховку самостоятельно?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, если условия тура это допускают. Сверьте требования туроператора и страны назначения."
          }
        },
        {
          "@type": "Question",
          "name": "Есть ли рассрочка в турагентстве «Жираф»?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Услуга заявлена на сайте; детали уточняйте у менеджера без публичного списка банков до подтверждения заказчиком."
          }
        },
        {
          "@type": "Question",
          "name": "Влияет ли рассрочка на срок выдачи документов?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зависит от условий оплаты в договоре. Полную выдачу пакета документов обычно привязывают к оплате по правилам оператора."
          }
        },
        {
          "@type": "Question",
          "name": "Что спросить про детей?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Отдельный полис на ребёнка, покрытие детских случаев и необходимость справок — у менеджера до оплаты."
          }
        },
        {
          "@type": "Question",
          "name": "Где офис для оплаты?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "г. Уфа, ул. Юрия Гагарина, 74/1, офис 3; телефон +7 901 810-50-18."
          }
        }
      ]
