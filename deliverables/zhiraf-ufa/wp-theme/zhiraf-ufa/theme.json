{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "background", "color": "#FAF8F5", "name": "Background" },
        { "slug": "primary", "color": "#E87A5D", "name": "Primary" },
        { "slug": "secondary", "color": "#2D2D2D", "name": "Secondary" },
        { "slug": "surface", "color": "#F5F2ED", "name": "Surface" },
        { "slug": "outline", "color": "#E8E3DC", "name": "Outline" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"Playfair Display\", Georgia, serif",
          "name": "Playfair Display",
          "slug": "playfair"
        },
        {
          "fontFamily": "Manrope, system-ui, sans-serif",
          "name": "Manrope",
          "slug": "manrope"
        }
      ],
      "fontSizes": [
        { "slug": "sm", "size": "14px", "name": "Small" },
        { "slug": "md", "size": "16px", "name": "Medium" },
        { "slug": "lg", "size": "18px", "name": "Large" },
        { "slug": "xl", "size": "32px", "name": "XL" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--secondary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair)",
          "fontWeight": "600"
        }
      },
      "link": {
        "color": { "text": "#E87A5D" }
      }
    }
  }
}
