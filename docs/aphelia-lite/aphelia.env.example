# Aphelia secrets — copy to aphelia-memory/aphelia.env.local (do NOT commit)

# --- TTS engine: qwen | yandex | elevenlabs ---
APHELIA_TTS_ENGINE=yandex

# Yandex SpeechKit (https://console.cloud.yandex.ru/)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# filipp | ermil | alena | jane | omazh | zahar
YANDEX_VOICE=filipp
YANDEX_SPEED=1.08

# ElevenLabs (https://elevenlabs.io/)
ELEVENLABS_API_KEY=
# voice id from ElevenLabs dashboard
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Lite profile (GTX 1660S 6GB): skip local GPU models
APHELIA_SKIP_ACE_STEP=1
APHELIA_REMBG_CPU=1
APHELIA_RENDER_CONCURRENCY=2
